{%- comment -%}
Creates a dropdown menu for filtering products by tag
Available tags: best-seller, new-arrival, discounted
{%- endcomment -%}
<form method="get" action="">
  <label for="tag-filter">Filter by Tag:</label>
  <select name="tag" id="tag-filter" onchange="this.form.submit()">
    <option value="">All</option>
    <option value="best-seller" {% if current_tags contains 'best-seller' %}selected{% endif %}>Best Seller</option>
    <option value="new-arrival" {% if current_tags contains 'new-arrival' %}selected{% endif %}>New Arrival</option>
    <option value="discounted" {% if current_tags contains 'discounted' %}selected{% endif %}>Discounted</option>
  </select>
</form>

{%- comment -%}
Loop through all products in the collection.
If a tag is selected, only show products that include it.
{%- endcomment -%}
{% assign selected_tag = current_tags.first %}
{% for product in collection.products %}
  {% if selected_tag == blank or product.tags contains selected_tag %}
    {% include 'product-card', product: product %}
  {% endif %}
{% endfor %}
